# Application title shown in the browser tab
VITE_APP_TITLE="SMART-on-FHIR Starter"

# SMART-on-FHIR Configuration
VITE_FHIR_CLIENT_ID="your-client-id"
VITE_FHIR_CLIENT_SECRET="your-client-secret"
VITE_FHIR_SCOPE="launch/patient patient/*.read"
VITE_FHIR_REDIRECT_URI="https://localhost:5000/launch-callback"
VITE_FHIR_ISS="https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4" 